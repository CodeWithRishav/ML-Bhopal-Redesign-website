# ML Bhopal Platform - Environment Variables Template
# Copy this file to .env.local for local overrides.
# In development, the app runs cleanly without any of these variables set.

# ==============================================================================
# 1. NOTIFICATION & INBOX CONFIGURATION
# ==============================================================================
# The destination email address where contact, ambassador, volunteer, and
# partnership submissions will be delivered.
# Default if omitted: "contact@mlbhopal.tech"
NOTIFICATION_EMAIL=contact@mlbhopal.tech

# ==============================================================================
# 2. GOOGLE SHEETS WEBHOOK (OPTIONAL)
# ==============================================================================
# Optional Google Apps Script / Webhook URL to automatically append new form
# submissions as rows in a Google Sheet.
# GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec

# ==============================================================================
# 3. SMTP / EMAIL DELIVERY (OPTIONAL)
# ==============================================================================
# If credentials are provided, nodemailer dispatches branded HTML notification
# emails for form submissions. If omitted, submissions are logged to the console
# and appended to content/submissions.json during local development.
#
# Supports generic SMTP or Gmail App Passwords:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Gmail-specific aliases (interchangeable with SMTP_USER / SMTP_PASS):
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
